# Habit Loop Mirror - Backend Environment Variables

# Database: SQLite for local zero-config testing or PostgreSQL for Supabase/production
DATABASE_URL=sqlite:///./habit_loop_mirror.db
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Supabase Auth JWT verification (Optional in development demo mode)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Kimi K3 (Moonshot AI) Adapter
# When empty, deterministic evidence-based templates are used automatically as fallback
KIMI_API_KEY=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
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
KIMI_TIMEOUT_SECONDS=15.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","https://*.vercel.app"]
